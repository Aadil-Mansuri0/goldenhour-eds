{
  "name": "goldenhour-eds",
  "version": "1.0.0",
  "description": "GoldenHour Emergency Dispatch System — production-style dispatch and route intelligence dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/unit/**/*.test.js tests/integration/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "lint": "eslint . --ext .js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "emergency",
    "dispatch",
    "ambulance",
    "healthcare",
    "dashboard",
    "route-optimization"
  ],
  "author": "GoldenHour Team",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eslint": "^9.17.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.17.0",
    "redis": "^4.7.0",
    "sqlite3": "^5.1.0",
    "uuid": "^10.0.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
